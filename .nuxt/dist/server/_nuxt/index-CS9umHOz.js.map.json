{"file":"index-CS9umHOz.js","mappings":";;;;;;;;;;;;;;;;;;;;;;AA6DA,UAAM,QAAQ;AAEd,UAAM,EAAE,OAAO,MAAM,QAAA,IAAY,SAAA;AACjC,UAAM,OAAO,SAAS,MAAM,MAAM,MAAM,MAAM,MAAM,CAAC;AACrD,UAAM,QAAQ,cAAc,MAAM,MAAM;AAExC,UAAM,MAAM,IAA4C,EAAE;AAC1D,UAAM,UAAU;AAAA,MAAS,MACvB,IAAI,UAAU,QAAQ,IAAI,UAAU,UAAU,IAAI,UAAU,UAAU,IAAI,UAAU;AAAA,IAAA;AAEtF;AAAA,MACE,MAAM,MAAM,MAAM,MAAM,MAAM;AAAA,MAC9B,CAAC,MAAM;AACL,cAAM,IAAI,KAAK,MAAM,MAAM,MAAM;AACjC,YAAI,CAAC,KAAK,CAAC,EAAG;AACd,YAAI,EAAE,aAAa,EAAE,UAAU,QAAQ;AAAA,iBAC9B,EAAE,aAAa,EAAE,UAAU,QAAQ;AAAA,iBACnC,EAAE,YAAY,EAAE,SAAS,QAAQ;AAAA,iBACjC,EAAE,YAAY,EAAE,SAAS,QAAQ;AAC1C,mBAAW,MAAO,IAAI,QAAQ,IAAK,GAAI;AAAA,MACzC;AAAA,IAAA;AAGF,aAAS,IAAI,GAAY;AACvB,UAAI,KAAK,KAAM,QAAO;AACtB,aAAO,EAAE,eAAe,OAAO;AAAA,IACjC;;;QAtFO,OAAM;AAAA,QAA0C,MAAK;AAAA,QAAS,cAAYA,MAAA,KAAA,EAAM;AAAA,MAAA,6sBASDC,eAAAD,MAAA,KAAA,EAAM,EAAE,2CAC/CC,eAAAD,MAAA,KAAA,EAAM,EAAE,iFAMrCA,MAAA,OAAA,IAAO,cAAA,gBAAA,wEAAA,CAAA,4EAEkCA,MAAA,OAAA,EAAA,CAAO,uPAU/CE,eAAA,CAAAF,MAAA,GAAA,0BAA4BA,MAAA,GAAA,MAAG,SAAA,eAAA,IAAA,6EAAA,CAAA,qBACrC,IAAIA,MAAA,IAAA,GAAM,aAAU,GAAA,CAAA,4DAGSE,eAAA,CAAAF,MAAA,GAAA,2BAA6BA,MAAA,GAAA,MAAG,SAAA,cAAA,IAAA,WAAA,CAAA,MAC3DC,eAAAD,MAAA,GAAA,mBAAqBA,MAAA,GAAA,MAAG,SAAA,MAAA,EAAA,+OAUpBE,eAAA,CAAAF,MAAA,GAAA,4BAA8BA,MAAA,GAAA,MAAG,WAAA,eAAA,IAAA,6EAAA,CAAA,qBACvC,IAAIA,MAAA,IAAA,GAAM,YAAS,GAAA,CAAA,4DAGUE,eAAA,CAAAF,MAAA,GAAA,6BAA+BA,MAAA,GAAA,MAAG,WAAA,cAAA,IAAA,WAAA,CAAA,MAC7DC,eAAAD,MAAA,GAAA,qBAAuBA,MAAA,GAAA,MAAG,WAAA,MAAA,EAAA;;;;;;;;;;;;;;ACwDzC,UAAM,WAAW,IAAmC,SAAS;AAC7D,UAAM,YAAY,IAA2B,SAAS;AACtD,UAAM,SAAS,IAAmB,IAAI;AAEtC,UAAM,EAAE,MAAA,IAAU,SAAA;AAClB,UAAM,OAAO,SAAS,MAAM,MAAM,MAAM,SAAS,KAAK,CAAC;AACvD,UAAM,gBAAgB;AAEtB,UAAM,gBAAgB;AAAA,MAAS,MAC7B,UAAU,UAAU,YAAY,aAAa;AAAA,IAAA;AAE/C,UAAM,eAAe;AAAA,MAAS,MAC5B,UAAU,UAAU,YAAY,YAAY;AAAA,IAAA;AAI9C,UAAM,aAAa,SAAS,MAAM;AAChC,UAAI,CAAC,OAAO,SAAS,CAAC,KAAK,MAAO,QAAO;AACzC,YAAM,IAAI,UAAU,UAAU,YAAY,KAAK,MAAM,YAAY,IAAI,KAAK,MAAM;AAChF,aAAO,KAAK,MAAM,OAAO,QAAQ,CAAC;AAAA,IACpC,CAAC;AAGD,UAAM,YAAY,SAAS,MAAM;AAC/B,UAAI,CAAC,OAAO,SAAS,CAAC,KAAK,MAAO,QAAO;AACzC,YAAM,IAAI,UAAU,UAAU,YAAY,KAAK,MAAM,aAAa,IAAI,KAAK,MAAM;AACjF,aAAO,KAAK,MAAM,OAAO,QAAQ,IAAI,GAAI,IAAI;AAAA,IAC/C,CAAC;AAED,UAAM,SAAS;AAAA,MAAS,MACtB,KAAK,QAAQ,KAAK,MAAM,aAAa,KAAK,MAAM,YAAY;AAAA,IAAA;AAG9D,aAAS,IAAI,GAAmB;AAC9B,UAAI,KAAK,QAAQ,MAAM,CAAC,EAAG,QAAO;AAClC,aAAO,EAAE,eAAe,SAAS,EAAE,uBAAuB,GAAG;AAAA,IAC/D;AAEA,aAAS,WAAW,GAAmB;AACrC,UAAI,KAAK,QAAQ,MAAM,CAAC,EAAG,QAAO;AAClC,aAAO,EAAE,eAAe,OAAO;AAAA,IACjC;;AAjJO,YAAA,OAAAG,eAAAC,WAAA,EAAA,OAAM,mCAA+B,MAAA,CAAA,CAAA,gSAAA;oBAMfJ,MAAA,aAAA,GAAa,CAAxB,GAAG,QAAG;gCAGNE,eAAA,CAAAF,MAAA,QAAA,MAAa,iNAIpB,iBAAeA,MAAA,QAAA,MAAa,GAAG,KAG7BC,eAAA,EAAE,EAAE;;wPAWGD,MAAA,SAAA,MAAS,YAAA,sCAAA,8CAAA,kFAAA,CAAA,gBAEhBK,cAAA,iBAAeL,MAAA,SAAA,MAAS,SAAA,wDAOjBA,MAAA,SAAA,MAAS,YAAA,sCAAA,8CAAA,kFAAA,CAAA,gBAEhBK,cAAA,iBAAeL,MAAA,SAAA,MAAS,SAAA,kFASTA,MAAA,MAAA,CAAM,oIAKrBK,cAAA,eAAaL,MAAA,SAAA,MAAS,YAAA,aAAA,UAAA,IACtBK,cAAA,OAAKL,MAAA,SAAA,MAAS,YAAA,QAAA,KAAA,0GAGZA,MAAA,SAAA,MAAS,YAAA,MAAA,KAAA,8SAUkDA,MAAA,aAAA,CAAa,mGAElC,WAAWA,MAAA,IAAA,GAAM,YAAS,GAAA,CAAA,+GAI/DK,cAAA,OAAKL,MAAA,SAAA,MAAS,YAAA,QAAA,KAAA,KACbC,eAAA,IAAID,MAAA,UAAA,CAAU,CAAA,8MAO6CA,MAAA,YAAA,CAAY,kGAEvC,WAAWA,MAAA,IAAA,GAAM,aAAU,GAAA,CAAA,+GAI5DK,cAAA,OAAKL,MAAA,SAAA,MAAS,YAAA,QAAA,KAAA,KACbC,eAAA,IAAID,MAAA,SAAA,CAAS,CAAA,qJAMsBC,eAAA,IAAID,MAAA,MAAA,IAAM,GAAA,CAAA;;;;;;;;;;;;;;ACRvC,QAAS,IAAI;AACpC,UAAM,eAAe,IAAI,KAAK;AACV,QAAI,KAAK;AAE7B,UAAM,QAAQ;AAAA,MACZ;AAAA,MACA;AAAA,MACA;AAAA,IAAA;;AA5FK,YAAA,OAAAG,eAAAC,WAAA,EAAA,OAAM,8EAA0E,MAAA,CAAA,CAAA,g4BAAA;AAqB9DE,oBAAA,QAAR,SAAI;waAMV,IAAI,CAAA,OAAA;AAAA;;UAiBDN,MAAA,YAAA,GAAY;;;;;;;;;;;;;;;;;;;AC8C1B,UAAM,EAAE,SAAS,WAAW,QAAA,IAAY,SAAA;AAExC,YAAQ,EAAE,OAAO,+DAA+D;;;;;AA5FzE,YAAA,OAAAG,eAAAC,WAAA,EAAA,OAAM,qEAAiE,MAAA,CAAA,CAAA,gPAAA;UAQxDJ,MAAA,SAAA,GAAS;;;;;8GAQdA,MAAA,SAAA,IAAS,2BAAA,iBAAA,qJAQNA,MAAA,SAAA,IAAS,4BAAA,2BAAA,iEAAA,CAAA,qBAEdA,MAAA,SAAA,IAAS,SAAA,KAAA,wjBAsBkDA,MAAA,OAAA,EAAA,CAAO;UAS3DA,MAAA,OAAA,GAAO;;AACJM,sBAAA,IAAL,MAAC;;;;;;AAWH,cAAAC,mBAAA,qBAAA,EAAA,QAAO,aAAS,MAAA,OAAA,CAAA;AAChB,cAAAA,mBAAA,qBAAA,EAAA,QAAO,WAAO,MAAA,OAAA,CAAA;AACd,cAAAA,mBAAA,qBAAA,EAAA,QAAO,WAAO,MAAA,OAAA,CAAA;;;;;;;;;;;;;;;;;","names":["_unref","_ssrInterpolate","_ssrRenderClass","_ssrRenderAttrs","_mergeProps","_ssrRenderAttr","_ssrRenderList","_ssrRenderComponent"],"sources":["../../../../components/RateCard.vue","../../../../components/RateCalculator.vue","../../../../components/PwaCtaCard.vue","../../../../pages/index.vue"],"sourcesContent":["<template>\n  <div class=\"card card-hover p-4 sm:p-6 h-full group\" role=\"group\" :aria-label=\"label.ar\">\n    <div class=\"flex items-center justify-between mb-4\">\n      <div class=\"flex items-center gap-2.5\">\n        <span class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-primary-50 text-brand-600 transition-transform duration-200 ease-in-out group-hover:scale-105\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6\" />\n          </svg>\n        </span>\n        <div>\n          <h3 class=\"font-bold text-base sm:text-lg leading-tight text-ink-strong\">{{ label.ar }}</h3>\n          <p class=\"text-[11px] text-muted\">{{ label.en }}</p>\n        </div>\n      </div>\n      <div class=\"text-left shrink-0\">\n        <span\n          class=\"block h-2 w-2 rounded-full mb-1 ml-auto transition-colors duration-200\"\n          :class=\"changed ? 'bg-accent' : 'bg-slate-300'\"\n        />\n        <p class=\"text-[11px] text-muted price-tabular\">{{ agoText() }}</p>\n      </div>\n    </div>\n\n    <div class=\"grid grid-cols-2 gap-3\">\n      <div class=\"rounded-xl bg-gain-soft p-3 sm:p-4 transition-all duration-200 ease-in-out\">\n        <p class=\"text-[10px] sm:text-xs font-bold text-gain mb-1\">\n          سعر البيع للمواطن (لكل 100$)\n        </p>\n        <p class=\"price-tabular num-update text-xl sm:text-2xl font-extrabold text-ink-strong\"\n           :class=\"dir === 'up' ? 'flash-up' : dir === 'down' ? 'flash-down' : ''\">\n          {{ fmt(rate?.sell_price * 100) }}\n        </p>\n        <p class=\"text-[10px] text-muted mt-1\">\n          <span class=\"font-bold\" :class=\"dir === 'up' ? 'text-gain' : dir === 'down' ? 'text-drop' : ''\">\n            {{ dir === 'up' ? '▲' : dir === 'down' ? '▼' : '' }}\n          </span>\n          مقابل 100 دولار\n        </p>\n      </div>\n      <div class=\"rounded-xl bg-primary-50 p-3 sm:p-4 transition-all duration-200 ease-in-out\">\n        <p class=\"text-[10px] sm:text-xs font-bold text-brand-600 mb-1\">\n          سعر الشراء من المواطن (لكل 100$)\n        </p>\n        <p class=\"price-tabular num-update text-xl sm:text-2xl font-extrabold text-ink-strong\"\n           :class=\"dir === 'up-s' ? 'flash-up' : dir === 'down-s' ? 'flash-down' : ''\">\n          {{ fmt(rate?.buy_price * 100) }}\n        </p>\n        <p class=\"text-[10px] text-muted mt-1\">\n          <span class=\"font-bold\" :class=\"dir === 'up-s' ? 'text-gain' : dir === 'down-s' ? 'text-drop' : ''\">\n            {{ dir === 'up-s' ? '▲' : dir === 'down-s' ? '▼' : '' }}\n          </span>\n          مقابل 100 دولار\n        </p>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\nimport type { RateRow } from '~/composables/useRates'\n\nconst props = defineProps<{ region: 'baghdad' | 'north' | 'south' }>()\n\nconst { rates, prev, agoText } = useRates()\nconst rate = computed(() => rates.value[props.region])\nconst label = REGION_LABELS[props.region]\n\nconst dir = ref<'up' | 'down' | 'up-s' | 'down-s' | ''>('')\nconst changed = computed(() =>\n  dir.value === 'up' || dir.value === 'down' || dir.value === 'up-s' || dir.value === 'down-s'\n)\nwatch(\n  () => rates.value[props.region],\n  (n) => {\n    const p = prev.value[props.region]\n    if (!n || !p) return\n    if (n.sell_price > p.sell) dir.value = 'up'\n    else if (n.sell_price < p.sell) dir.value = 'down'\n    else if (n.buy_price > p.buy) dir.value = 'up-s'\n    else if (n.buy_price < p.buy) dir.value = 'down-s'\n    setTimeout(() => (dir.value = ''), 1000)\n  }\n)\n\nfunction fmt(v?: number) {\n  if (v == null) return '—'\n  return v.toLocaleString('en-US')\n}\n</script>\n","<template>\n  <div class=\"card p-4 sm:p-6 lg:p-8 h-full\">\n    <div class=\"flex items-center justify-between mb-4 flex-wrap gap-3\">\n      <h2 class=\"font-bold text-base sm:text-xl text-ink-strong\">آلة حاسبة</h2>\n      <!-- Region tabs -->\n      <div class=\"flex rounded-xl border border-slate-200/80 bg-page p-1 gap-1 text-xs sm:text-sm\" role=\"tablist\" aria-label=\"اختيار المنطقة\">\n        <button\n          v-for=\"(r, key) in regionOptions\"\n          :key=\"key\"\n          class=\"px-3 sm:px-4 min-h-[40px] rounded-lg font-bold transition-all duration-200 ease-in-out\"\n          :class=\"selected === key\n            ? 'bg-brand-600 text-white shadow-sm'\n            : 'text-muted hover:bg-surface hover:text-ink'\"\n          role=\"tab\"\n          :aria-selected=\"selected === key\"\n          @click=\"selected = key\"\n        >\n          {{ r.ar }}\n        </button>\n      </div>\n    </div>\n\n    <div class=\"grid md:grid-cols-2 gap-4 lg:gap-6\">\n      <!-- Input side -->\n      <div>\n        <div class=\"flex rounded-xl border border-slate-200/80 bg-page p-1 gap-1 mb-3 text-sm\" role=\"tablist\" aria-label=\"اتجاه التحويل\">\n          <button\n            class=\"flex-1 min-h-[44px] rounded-lg font-bold transition-all duration-200 ease-in-out\"\n            :class=\"direction === 'usd2iqd' ? 'bg-brand-600 text-white shadow-sm' : 'text-muted hover:bg-surface hover:text-ink'\"\n            role=\"tab\"\n            :aria-selected=\"direction === 'usd2iqd'\"\n            @click=\"direction = 'usd2iqd'\"\n          >\n            USD → IQD\n          </button>\n          <button\n            class=\"flex-1 min-h-[44px] rounded-lg font-bold transition-all duration-200 ease-in-out\"\n            :class=\"direction === 'iqd2usd' ? 'bg-brand-600 text-white shadow-sm' : 'text-muted hover:bg-surface hover:text-ink'\"\n            role=\"tab\"\n            :aria-selected=\"direction === 'iqd2usd'\"\n            @click=\"direction = 'iqd2usd'\"\n          >\n            IQD → USD\n          </button>\n        </div>\n\n        <div class=\"relative\">\n          <input\n            v-model.number=\"amount\"\n            type=\"number\"\n            min=\"0\"\n            inputmode=\"decimal\"\n            class=\"input text-xl sm:text-2xl font-extrabold price-tabular font-['Cairo']\"\n            :placeholder=\"direction === 'usd2iqd' ? 'دولار...' : 'دينار...'\"\n            :dir=\"direction === 'usd2iqd' ? 'ltr' : 'rtl'\"\n          />\n          <span class=\"absolute left-3 top-1/2 -translate-y-1/2 text-base text-muted font-bold\">\n            {{ direction === 'usd2iqd' ? '$' : 'IQD' }}\n          </span>\n        </div>\n      </div>\n\n      <!-- Breakdown side -->\n      <div class=\"rounded-xl border border-slate-200/80 divide-y divide-slate-200/80 overflow-hidden\">\n        <div class=\"p-3 sm:p-4 bg-gain-soft\">\n          <div class=\"flex justify-between items-center gap-3\">\n            <div class=\"min-w-0\">\n              <p class=\"text-xs sm:text-sm font-bold text-ink\">إذا بعت {{ youAreSelling }} للمنفذ</p>\n              <p class=\"text-[11px] text-muted\">\n                سعر الشراء من المواطن (لكل 100$): {{ fmtDisplay(rate?.buy_price * 100) }}\n              </p>\n            </div>\n            <p class=\"price-tabular text-base sm:text-xl lg:text-2xl font-extrabold text-ink-strong shrink-0\"\n               :dir=\"direction === 'usd2iqd' ? 'rtl' : 'ltr'\">\n              {{ fmt(sellResult) }}\n            </p>\n          </div>\n        </div>\n        <div class=\"p-3 sm:p-4 bg-primary-50\">\n          <div class=\"flex justify-between items-center gap-3\">\n            <div class=\"min-w-0\">\n              <p class=\"text-xs sm:text-sm font-bold text-ink\">إذا اشريت {{ youAreBuying }} من المنفذ</p>\n              <p class=\"text-[11px] text-muted\">\n                سعر البيع للمواطن (لكل 100$): {{ fmtDisplay(rate?.sell_price * 100) }}\n              </p>\n            </div>\n            <p class=\"price-tabular text-base sm:text-xl lg:text-2xl font-extrabold text-ink-strong shrink-0\"\n               :dir=\"direction === 'usd2iqd' ? 'rtl' : 'ltr'\">\n              {{ fmt(buyResult) }}\n            </p>\n          </div>\n        </div>\n        <div class=\"p-2.5 sm:p-3 bg-page text-center\">\n          <p class=\"text-[10px] sm:text-xs text-muted\">\n            الفرق بين البيع والشراء (سعر المحل): {{ fmt(spread * 100) }} IQD لكل 100 دولار\n          </p>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\nimport type { RateRow } from '~/composables/useRates'\n\nconst selected = ref<'baghdad' | 'north' | 'south'>('baghdad')\nconst direction = ref<'usd2iqd' | 'iqd2usd'>('usd2iqd')\nconst amount = ref<number | null>(null)\n\nconst { rates } = useRates()\nconst rate = computed(() => rates.value[selected.value])\nconst regionOptions = REGION_LABELS\n\nconst youAreSelling = computed(() =>\n  direction.value === 'usd2iqd' ? 'دولاراتك' : 'ديناراتك'\n)\nconst youAreBuying = computed(() =>\n  direction.value === 'usd2iqd' ? 'دولارات' : 'دينارات'\n)\n\n// \"Sell to shop\" means the shop BUYS from the citizen -> use buy_price\nconst sellResult = computed(() => {\n  if (!amount.value || !rate.value) return 0\n  const r = direction.value === 'usd2iqd' ? rate.value.buy_price : 1 / rate.value.buy_price\n  return Math.floor(amount.value * r)\n})\n\n// \"Buy from shop\" means the shop SELLS to the citizen -> use sell_price\nconst buyResult = computed(() => {\n  if (!amount.value || !rate.value) return 0\n  const r = direction.value === 'usd2iqd' ? rate.value.sell_price : 1 / rate.value.sell_price\n  return Math.floor(amount.value * r * 1000) / 1000\n})\n\nconst spread = computed(() =>\n  rate.value ? rate.value.sell_price - rate.value.buy_price : 0\n)\n\nfunction fmt(v?: number | null) {\n  if (v == null || isNaN(v)) return '—'\n  return v.toLocaleString('en-US', { maximumFractionDigits: 2 })\n}\n\nfunction fmtDisplay(v?: number | null) {\n  if (v == null || isNaN(v)) return '—'\n  return v.toLocaleString('en-US')\n}\n</script>\n","<template>\n  <div class=\"card card-hover relative overflow-hidden p-5 sm:p-6 h-full flex flex-col\">\n    <!-- Flat accent bar -->\n    <span class=\"absolute inset-x-0 top-0 h-1.5 bg-brand-600\" aria-hidden=\"true\" />\n\n    <div class=\"flex items-center gap-3 mb-3\">\n      <span class=\"flex h-11 w-11 items-center justify-center rounded-xl bg-primary-50 text-brand-600 shrink-0\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-6 w-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4\" />\n        </svg>\n      </span>\n      <div>\n        <h3 class=\"font-bold text-base sm:text-lg text-ink-strong leading-tight\">حمّل التطبيق</h3>\n        <p class=\"text-[11px] text-muted leading-tight\">الدولار العراقي — PWA</p>\n      </div>\n    </div>\n\n    <p class=\"text-sm text-muted leading-relaxed mb-5\">\n      ثبّت التطبيق على هاتفك تثبيتاً مباشراً — يعمل بدون إنترنت ويفتح أسرع بكثير من المتصفح في المرة القادمة.\n    </p>\n\n    <ul class=\"space-y-2 mb-6\">\n      <li v-for=\"perk in perks\" :key=\"perk\" class=\"flex items-center gap-2 text-xs text-ink\">\n        <span class=\"flex h-4 w-4 items-center justify-center rounded-full bg-gain-soft text-gain shrink-0\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-3 w-3\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"3\" aria-hidden=\"true\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M5 13l4 4L19 7\" />\n          </svg>\n        </span>\n        {{ perk }}\n      </li>\n    </ul>\n\n    <button\n      class=\"btn btn-primary w-full mt-auto gap-2 text-sm\"\n      @click=\"handleInstallClick\"\n    >\n      <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-5 h-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" aria-hidden=\"true\">\n        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4\" />\n      </svg>\n      <span>تحميل التطبيق</span>\n    </button>\n\n    <!-- iOS install steps modal (fade transition) -->\n    <Transition name=\"fade\">\n      <div\n        v-if=\"showIosModal\"\n        class=\"fixed inset-0 z-50 flex items-center justify-center bg-slate-950/40 p-4\"\n        role=\"dialog\"\n        aria-modal=\"true\"\n        aria-label=\"إرشادات التثبيت على iOS\"\n        @click.self=\"showIosModal = false\"\n      >\n        <div class=\"bg-surface rounded-2xl p-6 max-w-sm w-full shadow-md border border-slate-200/80 text-center\">\n          <h3 class=\"text-lg font-bold text-ink-strong mb-2\">تثبيت تطبيق الدولار العراقي</h3>\n          <p class=\"text-sm text-muted mb-4 leading-relaxed\">\n            لتثبيت التطبيق على جهاز الآيفون الخاص بك، اتبع الخطوات البسيطة التالية:\n          </p>\n\n          <div class=\"space-y-3 text-right bg-page p-4 rounded-xl text-xs md:text-sm text-muted\">\n            <div class=\"flex items-center gap-3\">\n              <span class=\"bg-brand-600 text-white w-6 h-6 rounded-full flex items-center justify-center shrink-0 font-bold\">1</span>\n              <span>اضغط على زر المشاركة <strong class=\"text-brand-600\">Share</strong> في متصفح Safari.</span>\n            </div>\n            <div class=\"flex items-center gap-3\">\n              <span class=\"bg-brand-600 text-white w-6 h-6 rounded-full flex items-center justify-center shrink-0 font-bold\">2</span>\n              <span>انقر لأسفل واختر <strong class=\"text-brand-600\">\"إضافة إلى الشاشة الرئيسية\"</strong>.</span>\n            </div>\n            <div class=\"flex items-center gap-3\">\n              <span class=\"bg-brand-600 text-white w-6 h-6 rounded-full flex items-center justify-center shrink-0 font-bold\">3</span>\n              <span>اضغط على <strong class=\"text-brand-600\">إضافة (Add)</strong> في الأعلى لتثبيت التطبيق.</span>\n            </div>\n          </div>\n\n          <button\n            class=\"btn btn-primary w-full mt-5 text-sm\"\n            @click=\"showIosModal = false\"\n          >\n            فهمت ذلك\n          </button>\n        </div>\n      </div>\n    </Transition>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\nconst deferredPrompt = ref<any>(null)\nconst showIosModal = ref(false)\nconst isIosDevice = ref(false)\n\nconst perks = [\n  'تحديث لحظي مباشر للأسعار',\n  'يعمل حتى مع ضعف الإنترنت',\n  'لا يحتاج مساحة تخزين كبيرة',\n]\n\nonMounted(() => {\n  const userAgent = window.navigator.userAgent.toLowerCase()\n  isIosDevice.value = /iphone|ipad|ipod/.test(userAgent)\n\n  window.addEventListener('beforeinstallprompt', (e) => {\n    e.preventDefault()\n    deferredPrompt.value = e\n  })\n})\n\nasync function handleInstallClick() {\n  if (isIosDevice.value) {\n    showIosModal.value = true\n  } else if (deferredPrompt.value) {\n    deferredPrompt.value.prompt()\n    const { outcome } = await deferredPrompt.value.userChoice\n    if (outcome === 'accepted') deferredPrompt.value = null\n  } else {\n    alert('التطبيق مثبت مسبقاً أو أن المتصفح الحالي لا يدعم التثبيت التلقائي. يمكنك التثبيت عبر إعدادات المتصفح.')\n  }\n}\n</script>\n","<template>\n  <div class=\"mx-auto max-w-7xl 2xl:max-w-[1600px] px-4 sm:px-6 py-6 sm:py-10\">\n    <!-- ═══ Top Row Grid: Live status banner + last-updated badge ═══ -->\n    <section class=\"grid grid-cols-1 gap-3 mb-4 sm:mb-6\" aria-label=\"حالة التحديث\">\n      <div class=\"grid grid-cols-1 md:grid-cols-2 gap-3\">\n        <!-- Live status banner -->\n        <div\n          class=\"flex items-center gap-3 rounded-2xl border border-slate-200/80 bg-surface px-4 py-3 shadow-sm\"\n        >\n          <span v-if=\"connected\" class=\"live-pulse\"><span /><span /></span>\n          <span\n            v-else\n            class=\"h-2.5 w-2.5 shrink-0 rounded-full bg-slate-300\"\n            aria-hidden=\"true\"\n          />\n          <div class=\"min-w-0\">\n            <p class=\"text-sm font-bold text-ink-strong leading-tight\">\n              {{ connected ? 'البث المباشر يعمل الآن' : 'جارٍ الاتصال...' }}\n            </p>\n            <p class=\"text-[11px] text-muted leading-tight\">\n              أسعار صرف الدولار مقابل الدينار العراقي — تحديث لحظي\n            </p>\n          </div>\n          <span\n            class=\"ml-auto text-[10px] font-bold rounded-full px-2 py-0.5 shrink-0\"\n            :class=\"connected ? 'bg-emerald-50 text-gain' : 'bg-slate-100 text-muted'\"\n          >\n            {{ connected ? 'LIVE' : '...' }}\n          </span>\n        </div>\n\n        <!-- Last updated timestamp badge -->\n        <div\n          class=\"flex items-center justify-center md:justify-end gap-2 rounded-2xl border border-slate-200/80 bg-surface px-4 py-3 shadow-sm\"\n          aria-live=\"polite\"\n        >\n          <svg\n            xmlns=\"http://www.w3.org/2000/svg\"\n            class=\"h-4 w-4 text-accent shrink-0\"\n            fill=\"none\"\n            viewBox=\"0 0 24 24\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            aria-hidden=\"true\"\n          >\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z\" />\n          </svg>\n          <p class=\"text-sm text-ink\">\n            آخر تحديث:\n            <span class=\"font-extrabold text-ink-strong price-tabular\">{{ agoText() }}</span>\n          </p>\n        </div>\n      </div>\n    </section>\n\n    <!-- ═══ Main Grid ═══ -->\n    <section class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-6\">\n      <!-- Loading skeletons -->\n      <template v-if=\"loading\">\n        <div v-for=\"i in 3\" :key=\"`sk-${i}`\" class=\"card p-5 animate-pulse\" aria-busy=\"true\">\n          <div class=\"h-5 w-28 bg-slate-200 rounded mb-4\" />\n          <div class=\"grid grid-cols-2 gap-3\">\n            <div class=\"h-20 rounded-xl bg-slate-200\" />\n            <div class=\"h-20 rounded-xl bg-slate-200\" />\n          </div>\n        </div>\n      </template>\n\n      <!-- Exchange rate cards: Baghdad · Erbil · Basra (per 100$) -->\n      <template v-else>\n        <RateCard region=\"baghdad\" />\n        <RateCard region=\"north\" />\n        <RateCard region=\"south\" />\n      </template>\n\n      <!-- Interactive currency converter — dedicated grid card -->\n      <div class=\"md:col-span-2 lg:col-span-2\">\n        <RateCalculator />\n      </div>\n\n      <!-- PWA download/install CTA card — bottom grid span -->\n      <PwaCtaCard />\n    </section>\n\n    <p class=\"text-center text-[11px] sm:text-xs text-muted mt-4\">\n      سعر بغداد يتحدث تلقائياً من واجهة IQWealth — أسعار أربيل والبصرة تبقى تحت إشراف لوحة التحكم.\n    </p>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\nconst { loading, connected, agoText } = useRates()\n\nuseHead({ title: 'الدولار العراقي — سعر الدولار اليوم في بغداد وأربيل والبصرة' })\n</script>\n"],"version":3}