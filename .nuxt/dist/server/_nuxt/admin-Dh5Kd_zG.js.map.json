{"file":"admin-Dh5Kd_zG.js","mappings":";;;;;;;;;;;;;;;;;;;AAsFiB,gBAAA;AACjB,UAAM,EAAE,MAAe,IAAI,SAAA;AAE3B,UAAM,OAAO,IAAS,IAAI;AAC1B,UAAM,kBAAkB,IAAI,IAAI;AAChC,UAAM,QAAQ,IAAI,EAAE;AACpB,UAAM,WAAW,IAAI,EAAE;AACvB,UAAM,OAAO,IAAI,KAAK;AACtB,UAAM,QAAQ,IAAI,EAAE;AACpB,UAAM,SAAS,IAAI,KAAK;AACxB,UAAM,MAAM,IAAI,EAAE;AAClB,UAAM,QAAQ,IAAI,KAAK;AAEvB,UAAM,QAAQ,SAAwD;AAAA,MACpE,SAAS,EAAE,KAAK,GAAG,MAAM,EAAA;AAAA,MACzB,OAAO,EAAE,KAAK,GAAG,MAAM,EAAA;AAAA,MACvB,OAAO,EAAE,KAAK,GAAG,MAAM,EAAA;AAAA,IAAE,CAC1B;AAGD;AAAA,MACE,OAAO,EAAE,GAAG,MAAM;MAClB,CAAC,MAAM;AACL,mBAAW,UAAU,CAAC,WAAW,SAAS,OAAO,GAAe;AAC9D,cAAI,EAAE,MAAM,GAAG;AACb,kBAAM,MAAM,EAAE,MAAM,EAAE,MAAM,EAAE;AAC9B,kBAAM,MAAM,EAAE,OAAO,EAAE,MAAM,EAAE;AAAA,UACjC;AAAA,QACF;AAAA,MACF;AAAA,MACA,EAAE,WAAW,MAAM,MAAM,KAAA;AAAA,IAAK;AA0DhC,aAAS,UAAU,GAAW;AAC5B,aAAO,IAAI,KAAK,CAAC,EAAE,mBAAmB,SAAS,EAAE,MAAM,WAAW,QAAQ,WAAW;AAAA,IACvF;AAEA,YAAQ,EAAE,OAAO,iCAAiC;;AAjL3C,YAAA,OAAAA,eAAAC,WAAA,EAAA,OAAM,iCAA6B,MAAA,CAAA,CAAA,GAAA;AAE1B,UAAA,CAAAC,MAAA,IAAA,MAASA,MAAA,eAAA,GAAe;qPAKhBA,MAAA,KAAA,CAAK,gHACLA,MAAA,QAAA,CAAQ,0JACwCA,MAAA,IAAA,CAAI,IAAA,cAAA,qBAC/DA,MAAA,IAAA,IAAI,mBAAA,MAAA;YAEAA,MAAA,KAAA,GAAK;8EAA8CA,MAAA,KAAA,CAAK,CAAA,MAAA;AAAA;;;;iBAKrDA,MAAA,IAAA,GAAI;AAIuB,cAAA,yJAAAC,eAAAD,MAAA,IAAA,EAAK,KAAK,CAAA,qGAAA;sBAMpBA,MAAA,KAAA,GAAK,CAArB,KAAK,WAAM;kIAEKA,MAAA,aAAA,EAAc,MAAM,EAAY,IAAI,oBAAOA,MAAA,aAAA,EAAc,MAAM,EAAY,EAAE,4EAC/C,UAAU,IAAI,UAAU,CAAA,sMAQ3DA,MAAA,KAAA,EAAM,MAAM,EAAY,IAAI,6OAa5BA,MAAA,KAAA,EAAM,MAAM,EAAY,GAAG;;oJAasBA,MAAA,MAAA,CAAM,IAAA,cAAA,qBAC1EA,MAAA,MAAA,IAAM,wBAAA,iCAAA;YAEFA,MAAA,GAAA,GAAG;6CAA2CA,MAAA,KAAA,IAAK,kCAAA,gBAAA,0BAAA,CAAA,qBACvDA,MAAA,GAAA,CAAG;;;;;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_unref","_ssrInterpolate"],"sources":["../../../../pages/admin.vue"],"sourcesContent":["<template>\n  <div class=\"mx-auto max-w-3xl px-4 py-8\">\n    <!-- ─────────── Login state ─────────── -->\n    <div v-if=\"!user && !checkingSession\" class=\"card p-6 md:p-8 max-w-sm mx-auto\">\n      <h1 class=\"font-bold text-xl mb-1\">🔐 تسجيل دخول المشرف</h1>\n      <p class=\"text-xs text-slate-500 mb-5\">الدخول محمي — للمشرفين فقط</p>\n\n      <form @submit.prevent=\"signIn\" class=\"space-y-3\">\n        <input v-model=\"email\" type=\"email\" required placeholder=\"البريد الإلكتروني\" class=\"input\" dir=\"ltr\" />\n        <input v-model=\"password\" type=\"password\" required placeholder=\"كلمة المرور\" class=\"input\" dir=\"ltr\" />\n        <button type=\"submit\" class=\"btn btn-primary w-full\" :disabled=\"busy\">\n          {{ busy ? 'جارٍ الدخول...' : 'دخول' }}\n        </button>\n        <p v-if=\"error\" class=\"text-red-500 text-xs text-center\">{{ error }}</p>\n      </form>\n    </div>\n\n    <!-- ─────────── Dashboard state ─────────── -->\n    <div v-else-if=\"user\">\n      <div class=\"flex items-center justify-between mb-6\">\n        <div>\n          <h1 class=\"font-bold text-xl\">⚙️ لوحة تحكم المشرف</h1>\n          <p class=\"text-xs text-slate-500\">{{ user.email }}</p>\n        </div>\n        <button class=\"btn btn-ghost text-sm\" @click=\"signOut\">خروج</button>\n      </div>\n\n      <div class=\"grid gap-4\">\n        <div v-for=\"(row, region) in rates\" :key=\"region\" class=\"card p-4\">\n          <div class=\"flex items-center justify-between mb-3\">\n            <h2 class=\"font-bold\">{{ REGION_LABELS[region as Region].icon }} {{ REGION_LABELS[region as Region].ar }}</h2>\n            <span class=\"text-[11px] text-slate-400\">آخر تحديث: {{ shortTime(row.updated_at) }}</span>\n          </div>\n          <div class=\"grid grid-cols-2 gap-3\">\n            <div>\n              <label class=\"block text-[11px] text-mint-dark dark:text-mint mb-1 font-bold\">\n                سعر البيع للمواطن (IQD)\n              </label>\n              <input\n                v-model.number=\"draft[region as Region].sell\"\n                type=\"number\"\n                min=\"0\"\n                step=\"250\"\n                class=\"input tabular-nums\"\n                dir=\"ltr\"\n              />\n            </div>\n            <div>\n              <label class=\"block text-[11px] text-primary-700 dark:text-brand-500 mb-1 font-bold\">\n                سعر الشراء من المواطن (IQD)\n              </label>\n              <input\n                v-model.number=\"draft[region as Region].buy\"\n                type=\"number\"\n                min=\"0\"\n                step=\"250\"\n                class=\"input tabular-nums\"\n                dir=\"ltr\"\n              />\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"sticky bottom-4 mt-5\">\n        <button class=\"btn btn-primary w-full shadow-lg min-h-[48px]\" :disabled=\"saving\" @click=\"saveAll\">\n          {{ saving ? 'جارٍ الحفظ والبث...' : '💾 حفظ وبث التحديث لجميع الزوار' }}\n        </button>\n        <p v-if=\"msg\" class=\"text-center text-sm mt-2\" :class=\"msgOk ? 'text-mint-dark dark:text-mint' : 'text-red-500'\">\n          {{ msg }}\n        </p>\n      </div>\n    </div>\n\n    <!-- ─────────── Session check ─────────── -->\n    <div v-else class=\"py-20 text-center text-slate-400\">جارٍ التحقق من الجلسة...</div>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\nimport type { RateRow } from '~/composables/useRates'\nimport { REGION_LABELS } from '~/composables/useRates'\n\ntype Region = RateRow['region']\nconst REGIONS: Region[] = ['baghdad', 'north', 'south']\n\nconst supabase = useSupabase()\nconst { rates, refresh } = useRates()\n\nconst user = ref<any>(null)\nconst checkingSession = ref(true)\nconst email = ref('')\nconst password = ref('')\nconst busy = ref(false)\nconst error = ref('')\nconst saving = ref(false)\nconst msg = ref('')\nconst msgOk = ref(false)\n\nconst draft = reactive<Record<Region, { buy: number; sell: number }>>({\n  baghdad: { buy: 0, sell: 0 },\n  north: { buy: 0, sell: 0 },\n  south: { buy: 0, sell: 0 },\n})\n\n// Sync drafts whenever live rates change (e.g. landed mid-broadcast)\nwatch(\n  () => ({ ...rates.value }),\n  (r) => {\n    for (const region of ['baghdad', 'north', 'south'] as Region[]) {\n      if (r[region]) {\n        draft[region].buy = r[region].buy_price\n        draft[region].sell = r[region].sell_price\n      }\n    }\n  },\n  { immediate: true, deep: true }\n)\n\nonMounted(async () => {\n  const { data } = await supabase.auth.getSession()\n  user.value = data.session?.user ?? null\n  checkingSession.value = false\n\n  supabase.auth.onAuthStateChange((_event, session) => {\n    user.value = session?.user ?? null\n  })\n})\n\nasync function signIn() {\n  busy.value = true\n  error.value = ''\n  const { data, error: e } = await supabase.auth.signInWithPassword({\n    email: email.value,\n    password: password.value,\n  })\n  busy.value = false\n  if (e) error.value = e.message\n  else user.value = data.user\n}\n\nasync function signOut() {\n  await supabase.auth.signOut()\n  user.value = null\n}\n\nasync function saveAll() {\n  saving.value = true\n  msg.value = ''\n  try {\n    const { data: sessionData } = await supabase.auth.getSession()\n    const uid = sessionData.session?.user?.id\n    const updates = REGIONS.map((region) => ({\n      region,\n      region_ar: REGION_LABELS[region].ar,\n      buy_price: draft[region].buy,\n      sell_price: draft[region].sell,\n      updated_by: uid,\n      updated_at: new Date().toISOString(),\n    }))\n    const { error: e } = await supabase.from('rates').upsert(updates)\n    if (e) throw e\n    msgOk.value = true\n    msg.value = '✅ تم الحفظ — التحديث بُثّ مباشرةً لجميع الزوار'\n    await refresh()\n  } catch (e: any) {\n    msgOk.value = false\n    msg.value = '⚠️ فشل الحفظ: ' + (e.message ?? e)\n  } finally {\n    saving.value = false\n    setTimeout(() => (msg.value = ''), 4000)\n  }\n}\n\nfunction shortTime(t: string) {\n  return new Date(t).toLocaleTimeString('ar-IQ', { hour: '2-digit', minute: '2-digit' })\n}\n\nuseHead({ title: 'لوحة التحكم — الدولار العراقي' })\n\ndefinePageMeta({ layout: 'default' })\n</script>\n"],"version":3}