,UAAI,KAAK,QAAQ,MAAM,CAAC,EAAG,QAAO;AAClC,aAAO,EAAE,eAAe,SAAS,EAAE,uBAAuB,GAAG;AAAA,IAC/D;;AAjIO,YAAA,OAAAH,eAAAC,WAAA,EAAA,OAAM,4BAAwB,MAAA,CAAA,CAAA,mSAAA;oBAKRE,MAAA,aAAA,GAAa,CAAxB,GAAG,QAAG;gCAGNC,eAAA,CAAAD,MAAA,QAAA,MAAa,8LAKlBD,eAAA,EAAE,EAAE;;+NAWGC,MAAA,SAAA,MAAS,YAAA,4BAAA,8EAAA,iDAAA,CAAA,yDAOTA,MAAA,SAAA,MAAS,YAAA,4BAAA,8EAAA,iDAAA,CAAA,mFASDA,MAAA,MAAA,CAAM,6GAKrBE,cAAA,eAAaF,MAAA,SAAA,MAAS,YAAA,aAAA,UAAA,IACtBE,cAAA,OAAKF,MAAA,SAAA,MAAS,YAAA,QAAA,KAAA,0GAGZA,MAAA,SAAA,MAAS,YAAA,MAAA,KAAA,8WAU+EA,MAAA,aAAA,CAAa,sFAC1C,IAAIA,MAAA,IAAA,GAAM,SAAS,CAAA,6HAG7EE,cAAA,OAAKF,MAAA,SAAA,MAAS,YAAA,QAAA,KAAA,KACbD,eAAA,IAAIC,MAAA,UAAA,CAAU,CAAA,kQAO0EA,MAAA,YAAA,CAAY,qFAC/C,IAAIA,MAAA,IAAA,GAAM,UAAU,CAAA,oIAG1EE,cAAA,OAAKF,MAAA,SAAA,MAAS,YAAA,QAAA,KAAA,KACbD,eAAA,IAAIC,MAAA,SAAA,CAAS,CAAA,8KAMsBD,eAAA,IAAIC,MAAA,MAAA,CAAM,CAAA;;;;;;;;;;;;;;AC9C9D,UAAM,EAAE,SAAS,QAAA,IAAY,SAAA;AAE7B,YAAQ;AAAA,MACN,OAAO;AAAA,IAAA,CACR;;;;mBAxCMH,eAAAC,WAAA,EAAA,OAAM,qEAAiE,MAAA,CAAA,2fASUE,MAAA,OAAA,EAAA,CAAO;UAI5EA,MAAA,OAAA,GAAO;;AACHG,sBAAA,IAAL,MAAC;;;;;;AAUH,cAAAC,mBAAA,qBAAA,EAAA,QAAO,aAAS,MAAA,OAAA,CAAA;AAChB,cAAAA,mBAAA,qBAAA,EAAA,QAAO,WAAO,MAAA,OAAA,CAAA;AACd,cAAAA,mBAAA,qBAAA,EAAA,QAAO,WAAO,MAAA,OAAA,CAAA;;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_ssrInterpolate","_unref","_ssrRenderClass","_ssrRenderAttr","_ssrRenderList","_ssrRenderComponent"],"sources":["../../../../components/RateCard.vue","../../../../components/RateCalculator.vue","../../../../pages/index.vue"],"sourcesContent":["<template>\n  <div class=\"card p-4 sm:p-6 h-full\">\n    <div class=\"flex items-center justify-between mb-4\">\n      <div class=\"flex items-center gap-2 sm:gap-3\">\n        <span class=\"text-2xl sm:text-3xl\">{{ label.icon }}</span>\n        <div>\n          <h3 class=\"font-bold text-base sm:text-xl leading-tight text-slate-800 dark:text-slate-100\">{{ label.ar }}</h3>\n          <p class=\"text-[11px] sm:text-xs text-muted dark:text-slate-400\">{{ label.en }}</p>\n        </div>\n      </div>\n      <div class=\"text-left shrink-0\">\n        <div class=\"h-2 w-2 rounded-full mb-1 inline-block\"\n             :class=\"changed ? 'bg-cyan-highlight live-dot' : 'bg-slate-300 dark:bg-slate-700'\" />\n        <p class=\"text-[11px] text-muted dark:text-slate-500\">{{ agoText() }}</p>\n      </div>\n    </div>\n\n    <div class=\"grid grid-cols-2 gap-2.5 sm:gap-3\">\n      <div class=\"rounded-xl bg-mint/10 border border-mint/30 p-2.5 sm:p-4\">\n        <p class=\"text-[10px] sm:text-xs font-bold text-mint-dark dark:text-mint mb-1\">\n          سعر البيع للمواطن\n        </p>\n        <p class=\"price-tabular num-update text-lg sm:text-2xl lg:text-[1.75rem] font-extrabold text-mint-dark dark:text-mint\"\n           :class=\"dir === 'up' ? 'flash-up' : dir === 'down' ? 'flash-down' : ''\">\n          {{ fmt(rate?.sell_price) }}\n        </p>\n      </div>\n      <div class=\"rounded-xl bg-primary-50 dark:bg-brand-500/10 border border-primary-100 dark:border-brand-500/30 p-2.5 sm:p-4\">\n        <p class=\"text-[10px] sm:text-xs font-bold text-primary-700 dark:text-brand-500 mb-1\">\n          سعر الشراء من المواطن\n        </p>\n        <p class=\"price-tabular num-update text-lg sm:text-2xl lg:text-[1.75rem] font-extrabold text-primary-700 dark:text-brand-500\"\n           :class=\"dir === 'up-s' ? 'flash-up' : dir === 'down-s' ? 'flash-down' : ''\">\n          {{ fmt(rate?.buy_price) }}\n        </p>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\nimport type { RateRow } from '~/composables/useRates'\n\nconst props = defineProps<{ region: 'baghdad' | 'north' | 'south' }>()\n\nconst { rates, prev, agoText } = useRates()\nconst rate = computed(() => rates.value[props.region])\nconst label = REGION_LABELS[props.region]\n\nconst dir = ref<'up' | 'down' | 'up-s' | 'down-s' | ''>('')\nconst changed = computed(() =>\n  dir.value === 'up' || dir.value === 'down' || dir.value === 'up-s' || dir.value === 'down-s'\n)\nwatch(\n  () => rates.value[props.region],\n  (n) => {\n    const p = prev.value[props.region]\n    if (!n || !p) return\n    if (n.sell_price > p.sell) dir.value = 'up'\n    else if (n.sell_price < p.sell) dir.value = 'down'\n    else if (n.buy_price > p.buy) dir.value = 'up-s'\n    else if (n.buy_price < p.buy) dir.value = 'down-s'\n    setTimeout(() => (dir.value = ''), 1000)\n  }\n)\n\nfunction fmt(v?: number) {\n  if (v == null) return '—'\n  return v.toLocaleString('en-US')\n}\n</script>\n","<template>\n  <div class=\"card p-4 sm:p-6 lg:p-8\">\n    <div class=\"flex items-center justify-between mb-4 flex-wrap gap-3\">\n      <h2 class=\"font-bold text-base sm:text-xl text-slate-800 dark:text-slate-100\">🧮 آلة حاسبة متقدمة</h2>\n      <div class=\"flex rounded-xl border border-slate-300 dark:border-slate-700 overflow-hidden text-xs sm:text-sm\">\n        <button\n          v-for=\"(r, key) in regionOptions\"\n          :key=\"key\"\n          class=\"px-3 sm:px-4 min-h-[44px] sm:min-h-[48px] font-bold transition-colors\"\n          :class=\"selected === key\n            ? 'bg-brand-600 text-white'\n            : 'text-muted hover:bg-primary-50 dark:text-slate-300 dark:hover:bg-slate-800'\"\n          @click=\"selected = key\"\n        >\n          {{ r.ar }}\n        </button>\n      </div>\n    </div>\n\n    <div class=\"grid md:grid-cols-2 gap-4 lg:gap-6\">\n      <!-- Input side -->\n      <div>\n        <div class=\"flex rounded-xl border border-slate-300 dark:border-slate-700 overflow-hidden mb-3 text-sm\">\n          <button\n            class=\"flex-1 min-h-[48px] font-bold transition-colors\"\n            :class=\"direction === 'usd2iqd' ? 'bg-brand-600 text-white' : 'text-muted hover:bg-primary-50 dark:text-slate-300 dark:hover:bg-slate-800'\"\n            @click=\"direction = 'usd2iqd'\"\n          >\n            USD → IQD\n          </button>\n          <button\n            class=\"flex-1 min-h-[48px] font-bold transition-colors\"\n            :class=\"direction === 'iqd2usd' ? 'bg-brand-600 text-white' : 'text-muted hover:bg-primary-50 dark:text-slate-300 dark:hover:bg-slate-800'\"\n            @click=\"direction = 'iqd2usd'\"\n          >\n            IQD → USD\n          </button>\n        </div>\n\n        <div class=\"relative\">\n          <input\n            v-model.number=\"amount\"\n            type=\"number\"\n            min=\"0\"\n            inputmode=\"decimal\"\n            class=\"input text-xl sm:text-2xl font-extrabold price-tabular\"\n            :placeholder=\"direction === 'usd2iqd' ? 'دولار...' : 'دينار...'\"\n            :dir=\"direction === 'usd2iqd' ? 'ltr' : 'rtl'\"\n          />\n          <span class=\"absolute left-3 top-1/2 -translate-y-1/2 text-base text-muted font-bold\">\n            {{ direction === 'usd2iqd' ? '$' : 'IQD' }}\n          </span>\n        </div>\n      </div>\n\n      <!-- Breakdown side -->\n      <div class=\"rounded-xl border border-slate-200 dark:border-slate-800 divide-y divide-slate-200 dark:divide-slate-800 overflow-hidden\">\n        <div class=\"p-3 sm:p-4 bg-mint/5\">\n          <div class=\"flex justify-between items-center gap-3\">\n            <div class=\"min-w-0\">\n              <p class=\"text-xs sm:text-sm font-bold text-slate-700 dark:text-slate-200\">💰 إذا بعت {{ youAreSelling }} للمحل</p>\n              <p class=\"text-[11px] text-muted\">سعر الشراء من المواطن: {{ fmt(rate?.buy_price) }}</p>\n            </div>\n            <p class=\"price-tabular text-base sm:text-xl lg:text-2xl font-extrabold text-mint-dark dark:text-mint shrink-0\"\n               :dir=\"direction === 'usd2iqd' ? 'rtl' : 'ltr'\">\n              {{ fmt(sellResult) }}\n            </p>\n          </div>\n        </div>\n        <div class=\"p-3 sm:p-4 bg-primary-50/50 dark:bg-brand-500/5\">\n          <div class=\"flex justify-between items-center gap-3\">\n            <div class=\"min-w-0\">\n              <p class=\"text-xs sm:text-sm font-bold text-slate-700 dark:text-slate-200\">🛒 إذا اشريت {{ youAreBuying }} من المحل</p>\n              <p class=\"text-[11px] text-muted\">سعر البيع للمواطن: {{ fmt(rate?.sell_price) }}</p>\n            </div>\n            <p class=\"price-tabular text-base sm:text-xl lg:text-2xl font-extrabold text-primary-700 dark:text-brand-500 shrink-0\"\n               :dir=\"direction === 'usd2iqd' ? 'rtl' : 'ltr'\">\n              {{ fmt(buyResult) }}\n            </p>\n          </div>\n        </div>\n        <div class=\"p-2.5 sm:p-3 bg-slate-50 dark:bg-slate-800/40 text-center\">\n          <p class=\"text-[10px] sm:text-xs text-muted\">\n            الفرق بين البيع والشراء (سعر المحل): {{ fmt(spread) }} IQD لكل دولار\n          </p>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\nimport type { RateRow } from '~/composables/useRates'\n\nconst selected = ref<'baghdad' | 'north' | 'south'>('baghdad')\nconst direction = ref<'usd2iqd' | 'iqd2usd'>('usd2iqd')\nconst amount = ref<number | null>(null)\n\nconst { rates } = useRates()\nconst rate = computed(() => rates.value[selected.value])\nconst regionOptions = REGION_LABELS\n\nconst youAreSelling = computed(() =>\n  direction.value === 'usd2iqd' ? 'دولاراتك' : 'ديناراتك'\n)\nconst youAreBuying = computed(() =>\n  direction.value === 'usd2iqd' ? 'دولارات' : 'دينارات'\n)\n\n// \"Sell to shop\" means the shop BUYS from the citizen -> use buy_price\nconst sellResult = computed(() => {\n  if (!amount.value || !rate.value) return 0\n  const r = direction.value === 'usd2iqd' ? rate.value.buy_price : 1 / rate.value.buy_price\n  return Math.floor(amount.value * r)\n})\n\n// \"Buy from shop\" means the shop SELLS to the citizen -> use sell_price\nconst buyResult = computed(() => {\n  if (!amount.value || !rate.value) return 0\n  const r = direction.value === 'usd2iqd' ? rate.value.sell_price : 1 / rate.value.sell_price\n  return Math.floor(amount.value * r * 1000) / 1000\n})\n\nconst spread = computed(() =>\n  rate.value ? rate.value.sell_price - rate.value.buy_price : 0\n)\n\nfunction fmt(v?: number | null) {\n  if (v == null || isNaN(v)) return '—'\n  return v.toLocaleString('en-US', { maximumFractionDigits: 2 })\n}\n</script>\n","<template>\n  <div class=\"mx-auto max-w-7xl 2xl:max-w-[1600px] px-4 sm:px-6 py-6 sm:py-10\">\n    <section class=\"text-center mb-6 sm:mb-10\">\n      <h1 class=\"text-2xl sm:text-3xl lg:text-5xl font-extrabold tracking-tight text-primary-700 dark:text-white mb-2\">\n        سعر الدولار اليوم في العراق\n      </h1>\n      <p class=\"text-muted dark:text-slate-400 text-sm sm:text-base lg:text-lg\">\n        USD ↔ IQD · بغداد · الشمال · الجنوب — تحديث لحظي مباشر\n      </p>\n      <p class=\"mt-2 text-xs sm:text-sm text-muted dark:text-slate-500\" aria-live=\"polite\">\n        آخر تحديث: <span class=\"font-bold text-primary-700 dark:text-cyan-highlight\">{{ agoText() }}</span>\n      </p>\n    </section>\n\n    <section v-if=\"loading\" class=\"grid gap-4 sm:gap-5 md:grid-cols-3\" aria-busy=\"true\">\n      <div v-for=\"i in 3\" :key=\"i\" class=\"card p-5 sm:p-6 animate-pulse\">\n        <div class=\"h-5 w-24 bg-slate-200 dark:bg-slate-800 rounded mb-4\" />\n        <div class=\"grid grid-cols-2 gap-3\">\n          <div class=\"h-16 sm:h-20 bg-slate-200 dark:bg-slate-800 rounded-xl\" />\n          <div class=\"h-16 sm:h-20 bg-slate-200 dark:bg-slate-800 rounded-xl\" />\n        </div>\n      </div>\n    </section>\n\n    <section v-else class=\"grid gap-4 sm:gap-5 md:grid-cols-3\">\n      <RateCard region=\"baghdad\" />\n      <RateCard region=\"north\" />\n      <RateCard region=\"south\" />\n    </section>\n\n    <section class=\"mt-6 sm:mt-10\">\n      <RateCalculator />\n    </section>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\nconst { loading, agoText } = useRates()\n\nuseHead({\n  title: 'الدولار العراقي — سعر الدولار اليوم في بغداد وأربيل والبصرة'\n})\n</script>\n"],"version":3}